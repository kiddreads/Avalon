// Enable -ffast-math for the core build (PowerPC interp/JIT). Include this after a Release preset to override.
DOL_CORE_FAST_MATH = 1

// So the app can show "Fast math: On" in Settings
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) FAST_MATH_CORE_BUILD
